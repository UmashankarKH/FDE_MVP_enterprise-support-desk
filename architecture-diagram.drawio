          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="c1" source="c-5" target="c-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="c1" source="c-6" target="c-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="c1" source="c-7" target="c-branch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E8088;rounded=0;fontSize=9;" edge="1" parent="c1" source="c-branch" target="c-8a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce9" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B85450;rounded=0;fontSize=9;" edge="1" parent="c1" source="c-branch" target="c-8b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. Email Flow (Logic App)" id="page3-email">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="e0" />
        <mxCell id="e1" parent="e0" />
        <mxCell id="e-1" value="1. Customer sends real email to&#xa;umashankarkh@outlook.com&#xa;(via mailto: link or their own email app)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=11;" vertex="1" parent="e1">
          <mxGeometry x="300" y="20" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e-2" value="2. Logic App trigger:&#xa;When a new email arrives (V2)&#xa;[Outlook.com connector]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=11;fontStyle=1;" vertex="1" parent="e1">
          <mxGeometry x="300" y="130" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e-3" value="3. HTML to text&#xa;(strip formatting from Body)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=11;" vertex="1" parent="e1">
          <mxGeometry x="300" y="240" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-4" value="4. HTTP POST /api/email-intake&#xa;{from_email, subject, body}&#xa;+ X-Webhook-Secret header" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=11;fontStyle=1;" vertex="1" parent="e1">
          <mxGeometry x="300" y="340" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e-5" value="5. _verify_email_webhook_secret()&#xa;checks header == EMAIL_INTAKE_WEBHOOK_SECRET" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="e1">
          <mxGeometry x="280" y="450" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-6" value="6. TicketState created&#xa;channel=&#39;email&#39;, customer_id=from_email&#xa;-&gt; run_pipeline() (same pipeline&#xa;as chat, same guardrails and caches)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;fontStyle=1;" vertex="1" parent="e1">
          <mxGeometry x="270" y="550" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e-7" value="7. Response: {ticket_number,&#xa;resolution, reply_subject, ...}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="e1">
          <mxGeometry x="300" y="660" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-8" value="8. Parse JSON&#xa;(extract ticket_number, resolution)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="e1">
          <mxGeometry x="300" y="750" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-9" value="9. Reply to email (V3)&#xa;[Outlook.com connector]&#xa;composes reply with ticket number&#xa;+ resolution text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=11;fontStyle=1;" vertex="1" parent="e1">
          <mxGeometry x="300" y="840" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e-10" value="10. Customer receives reply&#xa;with real ticket number (e.g. INC1006)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=11;" vertex="1" parent="e1">
          <mxGeometry x="300" y="950" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ee1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="e1" source="e-1" target="e-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="e1" source="e-2" target="e-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="e1" source="e-3" target="e-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="e1" source="e-4" target="e-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="e1" source="e-5" target="e-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="e1" source="e-6" target="e-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="e1" source="e-7" target="e-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="e1" source="e-8" target="e-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="e1" source="e-9" target="e-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-note" value="Steps 2, 3, 9 run inside the Logic App (fde-email-intake-logicapp).&#xa;Steps 4-8 run inside the FastAPI backend (fde-backend-api) - the exact&#xa;same run_pipeline() used by chat, so guardrails and ticket numbering&#xa;are identical across channels." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6DC;strokeColor=#8A6D00;fontColor=#333333;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="e1">
          <mxGeometry x="650" y="340" width="280" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4. Guardrails and Human-in-the-loop" id="page4-guardrails">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="g0" />
        <mxCell id="g1" parent="g0" />
        <mxCell id="g-start" value="Critic Agent receives:&#xa;draft resolution, resolver_confidence,&#xa;proposed action, RAG citations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=11;fontStyle=1;" vertex="1" parent="g1">
          <mxGeometry x="360" y="20" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-llm" value="Flagship model reviews:&#xa;approved? reason? requires_human?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="380" y="130" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g-e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="g1" source="g-start" target="g-llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-note" value="Below this point, every check is enforced deterministically in code&#xa;(critic_agent.py) - NOT left to the LLM&#39;s judgment. Any one check&#xa;failing is enough to force human review, regardless of what the&#xa;model above said." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6DC;strokeColor=#8A6D00;fontColor=#333333;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="g1">
          <mxGeometry x="720" y="120" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g-check1" value="proposed_action ==&#xa;&#39;reset_2fa&#39; ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0000CC;fontSize=9;" vertex="1" parent="g1">
          <mxGeometry x="40" y="230" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-check2" value="proposed_action ==&#xa;&#39;provision_access&#39; AND&#xa;not approved by LLM?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0000CC;fontSize=9;" vertex="1" parent="g1">
          <mxGeometry x="230" y="230" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-check3" value="guardrail_flags contains&#xa;&#39;low_rag_confidence&#39; ?&#xa;(RAG confidence &lt; 0.45)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0000CC;fontSize=9;" vertex="1" parent="g1">
          <mxGeometry x="420" y="230" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-check4" value="resolver_confidence &lt;&#xa;50% ?&#xa;(hard floor, new)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0000CC;fontSize=9;fontStyle=1;" vertex="1" parent="g1">
          <mxGeometry x="610" y="230" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-check5" value="top KB citation&#39;s&#xa;confidence_tag !=&#xa;&#39;auto_resolve&#39; ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0000CC;fontSize=9;" vertex="1" parent="g1">
          <mxGeometry x="800" y="230" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="g1" source="g-llm" target="g-check1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="g1" source="g-llm" target="g-check2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="g1" source="g-llm" target="g-check3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="g1" source="g-llm" target="g-check4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="g1" source="g-llm" target="g-check5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-merge" value="requires_human = true&#xa;if ANY check above fired" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;fontStyle=1;" vertex="1" parent="g1">
          <mxGeometry x="400" y="350" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B85450;rounded=0;" edge="1" parent="g1" source="g-check1" target="g-merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B85450;rounded=0;" edge="1" parent="g1" source="g-check2" target="g-merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B85450;rounded=0;" edge="1" parent="g1" source="g-check3" target="g-merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B85450;rounded=0;" edge="1" parent="g1" source="g-check4" target="g-merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B85450;rounded=0;" edge="1" parent="g1" source="g-check5" target="g-merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-final" value="requires_human?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0000CC;fontSize=10;fontStyle=1;" vertex="1" parent="g1">
          <mxGeometry x="440" y="450" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-cachenote" parent="g1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6DC;strokeColor=#8A6D00;fontColor=#333333;fontSize=9;align=left;spacingLeft=8;" value="Cache hits never bypass this review: the Critic runs on every ticket. Only clean auto-resolves (no flags, KB tag auto_resolve) can enter the question cache." vertex="1">
          <mxGeometry height="80" width="300" x="40" y="440" as="geometry" />
        </mxCell>
        <mxCell id="g-e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="g1" source="g-merge" target="g-final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-auto" value="status = &#39;auto_resolved&#39;&#xa;Manager routes to Action Agent&#xa;Resolution delivered immediately" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="150" y="570" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-human" value="status = &#39;pending_human_approval&#39;&#xa;Ticket appears in Admin Dashboard&#xa;Human Safeguard Queue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;fontStyle=1;" vertex="1" parent="g1">
          <mxGeometry x="650" y="570" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-e12" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E8088;rounded=0;fontSize=9;" edge="1" parent="g1" source="g-final" target="g-auto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e13" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B85450;rounded=0;fontSize=9;" edge="1" parent="g1" source="g-final" target="g-human">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-reviewer" value="Human reviewer clicks&#xa;Approve or Reject &amp; Escalate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="650" y="670" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g-e14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="g1" source="g-human" target="g-reviewer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-decide" value="decision?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0000CC;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="700" y="760" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g-e15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="g1" source="g-reviewer" target="g-decide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-approved" value="POST /tickets/{id}/decision&#xa;{decision: &#39;approved&#39;}&#xa;-&gt; resume_after_human()&#xa;-&gt; Action Agent executes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="500" y="870" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g-rejected" value="POST /tickets/{id}/decision&#xa;{decision: &#39;rejected&#39;}&#xa;-&gt; Escalation Agent runs&#xa;status = &#39;escalated&#39;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="760" y="870" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g-e16" value="approved" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E8088;rounded=0;fontSize=9;" edge="1" parent="g1" source="g-decide" target="g-approved">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e17" value="rejected" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B85450;rounded=0;fontSize=9;" edge="1" parent="g1" source="g-decide" target="g-rejected">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. Admin Dashboard Live Data Flow" id="page5-dashboard">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="d0" />
        <mxCell id="d1" parent="d0" />
        <mxCell id="d-mount" value="Admin Dashboard mounts&#xa;(or &#39;Resume live&#39; clicked)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="380" y="20" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d-timer" value="setInterval every 15 seconds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontColor=#0000CC;fontSize=10;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="400" y="120" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d-e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="d1" source="d-mount" target="d-timer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-token" value="acquireTokenSilent()&#xa;(MSAL, falls back to popup&#xa;only if interaction required)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="d1">
          <mxGeometry x="380" y="210" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="d1" source="d-timer" target="d-token">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-stats" value="GET /tickets/stats&#xa;(unique_users, resolved,&#xa;escalated, not_resolved,&#xa;resolution_rate_pct, by_channel)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="d1">
          <mxGeometry x="140" y="320" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d-tickets" value="GET /tickets?limit=200&#xa;(full Cosmos DB ticket list,&#xa;every channel, every customer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="d1">
          <mxGeometry x="580" y="320" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="d1" source="d-token" target="d-stats">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="d1" source="d-token" target="d-tickets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-map" value="mapBackendTicket() converts each&#xa;Cosmos doc -&gt; frontend Ticket shape&#xa;(synthesizes customer, priority,&#xa;relative timestamps, backendTicketId)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="560" y="440" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="d1" source="d-tickets" target="d-map">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-render" value="Dashboard re-renders:&#xa;Live Backend Usage card, ticket table&#xa;(with date-range filter), Approvals queue,&#xa;Analytics charts - all from live data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="300" y="550" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="d1" source="d-stats" target="d-render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="d1" source="d-map" target="d-render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-approve" value="Admin clicks Approve / Reject&#xa;in Human Safeguard Queue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" vertex="1" parent="d1">
          <mxGeometry x="300" y="670" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="d1" source="d-render" target="d-approve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-postdecision" value="postHumanDecision(): POST&#xa;/tickets/{backendTicketId}/decision&#xa;then immediately re-syncs&#xa;(no waiting for next 15s tick)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="300" y="770" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d-e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;" edge="1" parent="d1" source="d-approve" target="d-postdecision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-e9" value="loops back" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;dashed=1;fontSize=8;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="d1" source="d-postdecision" target="d-stats">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-cache" parent="d1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#0E8088;fontColor=#0000CC;fontSize=10;" value="GET /cache/stats&#xa;(Cache Memory panel: hits, misses, hit rate,&#xa;question cache line)" vertex="1">
          <mxGeometry height="70" width="260" x="700" y="210" as="geometry" />
        </mxCell>
        <mxCell id="d-e-cache" edge="1" parent="d1" source="d-token" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#0E8088;rounded=0;fontSize=9;" target="d-cache" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-note" value="Without this, Approve/Reject only updated local browser state -&#xa;the next 15s poll would silently revert it back to &#39;Pending Approval&#39;&#xa;since Cosmos DB still showed the old status. Fixed by actually calling&#xa;the real decision endpoint before re-syncing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6DC;strokeColor=#8A6D00;fontColor=#333333;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="d1">
          <mxGeometry x="700" y="670" width="260" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. Caching Flow" id="page6-caching">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="k0" />
        <mxCell id="k1" parent="k0" />
        <mxCell id="k-1" parent="k1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" value="1. Message arrives at run_pipeline()" vertex="1">
          <mxGeometry height="50" width="240" x="330" y="20" as="geometry" />
        </mxCell>
        <mxCell id="k-2" parent="k1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0000CC;fontSize=9;fontStyle=1;" value="Question cache:&#xa;normalised text seen before?" vertex="1">
          <mxGeometry height="80" width="260" x="320" y="100" as="geometry" />
        </mxCell>
        <mxCell id="k-hit1" parent="k1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#0E8088;fontColor=#0000CC;fontSize=9;fontStyle=1;" value="HIT: apply category + request type,&#xa;fresh ticket number.&#xa;Skip Intake and Triage LLM calls" vertex="1">
          <mxGeometry height="70" width="260" x="40" y="220" as="geometry" />
        </mxCell>
        <mxCell id="k-miss1" parent="k1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" value="MISS: Intake -&gt; Triage&#xa;(mini model calls)" vertex="1">
          <mxGeometry height="60" width="240" x="600" y="220" as="geometry" />
        </mxCell>
        <mxCell id="k-rag" parent="k1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" value="RAG: vector search, top citation + confidence" vertex="1">
          <mxGeometry height="50" width="300" x="300" y="330" as="geometry" />
        </mxCell>
        <mxCell id="k-3" parent="k1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0000CC;fontSize=9;fontStyle=1;" value="Resolution cache:&#xa;top citation cached and&#xa;RAG confidence &gt;= 0.55?" vertex="1">
          <mxGeometry height="90" width="260" x="320" y="420" as="geometry" />
        </mxCell>
        <mxCell id="k-hit2" parent="k1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#0E8088;fontColor=#0000CC;fontSize=9;fontStyle=1;" value="HIT: reuse cached draft.&#xa;Skip flagship Resolver call" vertex="1">
          <mxGeometry height="60" width="260" x="40" y="550" as="geometry" />
        </mxCell>
        <mxCell id="k-miss2" parent="k1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" value="MISS: Resolver tool loop&#xa;(max 4 tool calls)" vertex="1">
          <mxGeometry height="60" width="240" x="600" y="550" as="geometry" />
        </mxCell>
        <mxCell id="k-store2" parent="k1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;" value="Store draft only if cache enabled,&#xa;citation exists, RAG &gt;= 0.55 and&#xa;resolver confidence meets threshold" vertex="1">
          <mxGeometry height="70" width="260" x="590" y="640" as="geometry" />
        </mxCell>
        <mxCell id="k-critic" parent="k1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#0000CC;fontSize=10;fontStyle=1;" value="Critic reviews EVERY ticket (guardrails always run)" vertex="1">
          <mxGeometry height="50" width="320" x="290" y="750" as="geometry" />
        </mxCell>
        <mxCell id="k-end" parent="k1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0000CC;fontSize=9;fontStyle=1;" value="Auto-resolved, clean, no flags, KB tag auto_resolve?&#xa;YES: question_cache.maybe_store()&#xa;NO: never cached (goes to human or Action as usual)" vertex="1">
          <mxGeometry height="120" width="440" x="230" y="840" as="geometry" />
        </mxCell>
        <mxCell id="k-note" parent="k1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6DC;strokeColor=#8A6D00;fontColor=#333333;fontSize=9;align=left;spacingLeft=8;" value="Both caches: in-memory OrderedDict in the API process. TTL 24h, max 500 entries. Lost on restart and not shared across replicas (Redis is the upgrade path)." vertex="1">
          <mxGeometry height="100" width="260" x="700" y="840" as="geometry" />
        </mxCell>
        <mxCell id="ke1" edge="1" parent="k1" source="k-1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;fontSize=9;" target="k-2" value="">
          <mxGeometry relative="1" as="geometry" />
