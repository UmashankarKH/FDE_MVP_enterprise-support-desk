        <mxCell id="ke10" edge="1" parent="k1" source="k-hit2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;fontSize=9;" target="k-critic" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ke11" edge="1" parent="k1" source="k-store2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;fontSize=9;" target="k-critic" value="">
