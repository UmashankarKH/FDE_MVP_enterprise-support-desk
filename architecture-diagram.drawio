          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ke3" edge="1" parent="k1" source="k-2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;rounded=0;fontSize=9;" target="k-miss1" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
